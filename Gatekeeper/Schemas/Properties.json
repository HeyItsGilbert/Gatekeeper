{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://heyitsgilbert.github.io/Gatekeeper/schema/1.0.0/Properties.json",
    "title": "Property Metadata Schema",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        }
    },
    "additionalProperties": {
        "type": "object",
        "required": [
            "Type"
        ],
        "properties": {
            "Type": {
                "type": "string",
                "enum": [
                    "string",
                    "integer",
                    "boolean"
                ]
            },
            "Enum": {
                "type": "array",
                "items": {}
            },
            "Validation": {
                "type": "object",
                "properties": {
                    "Minimum": {
                        "type": "integer"
                    },
                    "Maximum": {
                        "type": "integer"
                    },
                    "MinLength": {
                        "type": "integer"
                    },
                    "MaxLength": {
                        "type": "integer"
                    },
                    "Pattern": {
                        "type": "string",
                        "format": "regex"
                    }
                },
                "additionalProperties": false
            }
        },
        "additionalProperties": false,
        "if": {
            "properties": {
                "Type": {
                    "const": "integer"
                }
            }
        },
        "then": {
            "properties": {
                "Validation": {
                    "properties": {
                        "MinLength": false,
                        "MaxLength": false,
                        "Pattern": false
                    }
                }
            }
        },
        "else": {
            "if": {
                "properties": {
                    "Type": {
                        "const": "string"
                    }
                }
            },
            "then": {
                "properties": {
                    "Validation": {
                        "properties": {
                            "Minimum": false,
                            "Maximum": false
                        }
                    }
                }
            },
            "else": {
                "properties": {
                    "Validation": {
                        "properties": {
                            "Minimum": false,
                            "Maximum": false,
                            "MinLength": false,
                            "MaxLength": false,
                            "Pattern": false
                        }
                    }
                }
            }
        }
    },
    "$comment": "Minimum > Maximum on the same property is not enforced here: JSON Schema cannot compare two sibling values declaratively (no $data support in Test-Json or the default jsonschema validators). That check is bind-time PowerShell work tracked by ADR 0007 / issue #103 item 21."
}
