[
    {
        "name": "allow-rule-matches",
        "kind": "flag",
        "propertySet": "../property-sets/basic.json",
        "flag": {
            "Name": "AllowFlag", "Version": "1.0.0", "Author": "Test", "DefaultEffect": "Deny",
            "Rules": [ { "Name": "AllowRule", "Effect": "Allow", "Condition": { "Property": "IsCompliant", "Operator": "Equals", "Value": true } } ]
        },
        "context": { "Environment": "Staging", "IsCompliant": true, "Percentage": 30 },
        "expect": {
            "decision": { "effect": "Allow", "result": true, "ruleName": "AllowRule", "isDefault": false },
            "events": [ { "ruleName": "AllowRule", "effect": "Allow", "isDefault": false } ]
        }
    },
    {
        "name": "deny-rule-matches",
        "kind": "flag",
        "propertySet": "../property-sets/basic.json",
        "flag": {
            "Name": "DenyFlag", "Version": "1.0.0", "Author": "Test", "DefaultEffect": "Allow",
            "Rules": [ { "Name": "DenyRule", "Effect": "Deny", "Condition": { "Property": "IsCompliant", "Operator": "Equals", "Value": true } } ]
        },
        "context": { "Environment": "Staging", "IsCompliant": true, "Percentage": 30 },
        "expect": {
            "decision": { "effect": "Deny", "result": false, "ruleName": "DenyRule", "isDefault": false }
        }
    },
    {
        "name": "audit-is-observed-and-non-terminal",
        "description": "Audit logs and evaluation continues; the later Allow still wins the Decision.",
        "kind": "flag",
        "propertySet": "../property-sets/basic.json",
        "flag": {
            "Name": "AuditFlag", "Version": "1.0.0", "Author": "Test", "DefaultEffect": "Deny",
            "Rules": [
                { "Name": "AuditRule", "Effect": "Audit", "Condition": { "Property": "IsCompliant", "Operator": "Equals", "Value": true } },
                { "Name": "AllowRule", "Effect": "Allow", "Condition": { "Property": "IsCompliant", "Operator": "Equals", "Value": true } }
            ]
        },
        "context": { "Environment": "Staging", "IsCompliant": true, "Percentage": 30 },
        "expect": {
            "decision": { "effect": "Allow", "result": true, "ruleName": "AllowRule", "isDefault": false },
            "events": [
                { "ruleName": "AuditRule", "effect": "Audit", "isDefault": false },
                { "ruleName": "AllowRule", "effect": "Allow", "isDefault": false }
            ]
        }
    },
